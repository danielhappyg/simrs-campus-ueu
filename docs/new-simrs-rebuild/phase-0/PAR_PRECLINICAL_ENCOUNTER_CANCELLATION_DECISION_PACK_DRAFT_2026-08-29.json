  "decision_questions": [
    {"decision_id": "CAN-01", "topic": "eligible_state", "recommendation": "Only REGISTERED is eligible.", "required_authorities": ["registration_admission", "clinical", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-02", "topic": "care_start_blocker", "recommendation": "Block when any dependent fact exists regardless of encounter status.", "required_authorities": ["clinical", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-03", "topic": "reason_catalogue", "recommendation": "Require a stable reason code and allow an optional Indonesian note of at most 500 characters.", "required_authorities": ["registration_admission"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-04", "topic": "permitted_reason_codes", "recommendation": "Use the four bounded reason codes in the FR pack without an ungoverned catch-all.", "required_authorities": ["registration_admission", "emergency_clinical", "facility_bed_management"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-05", "topic": "actor", "recommendation": "Require encounter.cancel; registrar is routine actor and admin is governed correction only.", "required_authorities": ["registration_admission", "product_authority"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-06", "topic": "queue_effect", "recommendation": "Preserve queue date and number; never decrement or reuse.", "required_authorities": ["registration_admission", "reporting_quality"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-07", "topic": "active_worklists", "recommendation": "Exclude CANCELLED from every active clinical, registration, diagnostic, RM, bed, and dashboard worklist.", "required_authorities": ["registration_admission", "clinical", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-08", "topic": "historical_registers", "recommendation": "Retain one Dibatalkan row and separately reconcile gross, active, cancelled, and completed totals.", "required_authorities": ["reporting_quality", "registration_admission"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-09", "topic": "rawat_inap_bed_effect", "recommendation": "Release only current app occupancy while retaining original placement history.", "required_authorities": ["facility_bed_management", "registration_admission"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-10", "topic": "retry_behavior", "recommendation": "Replay the same actor key and payload; conflict on changed payload.", "required_authorities": ["security_privacy_data", "operations"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-11", "topic": "repeated_cancellation", "recommendation": "Allow only exact idempotent replay; reject a second semantic cancellation.", "required_authorities": ["registration_admission", "security_privacy_data"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-12", "topic": "downstream_facts_added_later", "recommendation": "Hard-block and route to a separately approved reversal or correction workflow.", "required_authorities": ["billing_finance", "pharmacy", "inventory", "claims"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-13", "topic": "patient_and_mrn_effect", "recommendation": "Retain patient and MRN; cancel only the encounter.", "required_authorities": ["patient_identity", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-14", "topic": "schedule_capacity", "recommendation": "Make no clinic capacity restoration claim without an authoritative capacity ledger.", "required_authorities": ["outpatient_scheduling", "registration_admission"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-15", "topic": "printing", "recommendation": "Block ordinary active output and require a separately approved visibly cancelled receipt if one is needed.", "required_authorities": ["registration_admission", "rmik_records", "reporting_quality"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-16", "topic": "related_encounters", "recommendation": "Never cascade automatically across continued or related encounters.", "required_authorities": ["registration_admission", "clinical", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-17", "topic": "terminal_state", "recommendation": "CANCELLED is terminal; later care requires a new encounter and queue number.", "required_authorities": ["product_authority", "registration_admission", "rmik_records"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
    {"decision_id": "CAN-18", "topic": "external_systems", "recommendation": "Record local cancellation only and make no external integration call or success claim.", "required_authorities": ["product_authority", "security_privacy_data"], "status": "pending", "recorded_choice": null, "decision_reference": null, "implementation_authorized": false},
