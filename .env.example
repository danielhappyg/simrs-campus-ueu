APP_NAME="SIMRS Campus UEU"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MODE=SIMULATION
APP_SYNTHETIC_ONLY=true
DEMO_SEED_ENABLED=false
DEMO_ACCOUNT_PASSWORD=
TEACHING_ROLE_ACCESS_PASSWORD=
TEACHING_ROLE_ACCESS_COMMITMENT_KEY=
TEACHING_ROLE_ACCESS_MAX_TTL_MINUTES=30
RECAP_CSV_MAX_ROWS=5000
RECAP_CSV_MAX_BYTES=10000000
RECAP_CSV_MAX_EXECUTION_SECONDS=30
RECAP_CSV_USER_ATTEMPTS_PER_MINUTE=3
RECAP_CSV_GLOBAL_ATTEMPTS_PER_MINUTE=30
RECAP_CSV_MAX_ACTIVE_EXPORTS=2
RECAP_CSV_LOCK_SECONDS=120
FORTIFY_PASSWORD_RESET_EMAIL_IP_LIMIT=5
FORTIFY_PASSWORD_RESET_IP_LIMIT=30
FORTIFY_PASSWORD_RESET_DECAY_SECONDS=60
BREAK_GLASS_MODE=off
BREAK_GLASS_DEFAULT_TTL_MINUTES=15
BREAK_GLASS_MAXIMUM_TTL_MINUTES=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_URL=postgres://user:password@host:5432/database
# DB_SCHEMA=public
# DB_SSLMODE=require
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Exact-engine warehouse access is fail-closed until every value below is
# provisioned with separate credentials and matching database grants.
# Keep false for ordinary application migration runs. A separately governed
# warehouse schema cutover sets this true only while DB_CONNECTION is exactly
# warehouse_migrator and the identity/routine rehearsal has passed.
WAREHOUSE_SCHEMA_MIGRATION_ENABLED=false
# WAREHOUSE_DB_DRIVER=pgsql
# WAREHOUSE_DB_HOST=127.0.0.1
# WAREHOUSE_DB_PORT=5432
# WAREHOUSE_DB_DATABASE=laravel
# WAREHOUSE_DB_SCHEMA=public
# WAREHOUSE_DB_SSLMODE=require
# WAREHOUSE_RUNTIME_DB_USERNAME=
# WAREHOUSE_RUNTIME_DB_PASSWORD=
# WAREHOUSE_RUNTIME_DB_IDENTITY=
# WAREHOUSE_WRITER_DB_USERNAME=
# WAREHOUSE_WRITER_DB_PASSWORD=
# WAREHOUSE_WRITER_DB_IDENTITY=
# WAREHOUSE_MIGRATOR_DB_USERNAME=
# WAREHOUSE_MIGRATOR_DB_PASSWORD=
# WAREHOUSE_MIGRATOR_DB_IDENTITY=
# WAREHOUSE_RESET_EXECUTOR_DB_USERNAME=
# WAREHOUSE_RESET_EXECUTOR_DB_PASSWORD=
# WAREHOUSE_RESET_EXECUTOR_DB_IDENTITY=
# WAREHOUSE_RESET_OWNER_DB_IDENTITY=

SESSION_DRIVER=database
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="simrs-campus@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
